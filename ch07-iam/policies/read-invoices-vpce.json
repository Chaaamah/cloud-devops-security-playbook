{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInvoicesFromOurNetworkOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::acme-prod-invoices/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceVpce": "vpce-0a1b2c3d4e5f67890",
          "aws:PrincipalOrgID": "o-exampleorgid"
        }
      }
    }
  ]
}
